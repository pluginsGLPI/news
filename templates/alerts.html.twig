{#
 # Alerts list, displayed by the GLPI hooks.
 # `wrapper` matches the place of the hook output:
 #   - 'central': inside the central page table,
 #   - 'list':    above a list (table header row),
 #   - 'login':   on the login page,
 #   - null:      no wrapper.
 #}

{% set alerts_html %}
    {# No whitespace inside the container: it is hidden by CSS when :empty #}
    <div class="plugin_news_alert-container row align-items-stretch">
        {%- for alert in alerts -%}
            {{ include('@news/display_alert.html.twig', alert, with_context=false) }}
        {%- endfor -%}

        {%- if hidden_alerts_url is not null -%}
            <div class="center">
                <a href="{{ hidden_alerts_url }}">{{ __('You have hidden alerts valid for current date', 'news') }}</a>
            </div>
        {%- endif -%}
    </div>
{% endset %}

{% if wrapper == 'central' %}
    <tr><td colspan="2">{{ alerts_html }}</td></tr>
{% elseif wrapper == 'list' %}
    <tr><th colspan="2">{{ alerts_html }}</th></tr>
{% elseif wrapper == 'login' %}
    {{ call('Html::css', ['/plugins/news/css/styles.css'])|raw }}
    <div class="plugin_news_alert-login">{{ alerts_html }}</div>
{% else %}
    {{ alerts_html }}
{% endif %}

{% if load_script %}
    {{ call('Html::script', ['/plugins/news/js/news.js'])|raw }}
{% endif %}

