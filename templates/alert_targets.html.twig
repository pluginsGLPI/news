{% import 'components/form/fields_macros.html.twig' as fields %}

{% if canedit %}
    <div class="mb-3">
        <form method="post" action="{{ 'PluginNewsAlert'|itemtype_form_path }}">
            <input type="hidden" name="plugin_news_alerts_id" value="{{ alert.getID() }}">
            {{ fields.csrfField() }}
            <div class="d-flex flex-wrap">
                {{ fields.dropdownItemTypes('itemtype', '', __('Add a target', 'news'), {
                    types: ['Group', 'Profile', 'User'],
                    rand: rand,
                    inline_add_field_html: true,
                    add_field_html: '<span id="plugin_news_targets' ~ rand ~ '"></span>',
                }) }}
            </div>
            <script>
                $('#dropdown_itemtype{{ rand }}').on('change', (e) => {
                    $('#plugin_news_targets{{ rand }}').load(
                        {{ targets_url|json_encode|raw }},
                        {
                            ...{{ targets_params|json_encode|raw }},
                            type: e.target.value,
                        }
                    );
                });
            </script>
        </form>
    </div>
{% endif %}

{% include 'components/datatable.html.twig' with {
    is_tab: true,
    nofilter: true,
    nosort: true,
    columns: {
        type: __('Type', 'news'),
        recipient: __('Recipient', 'news'),
    },
    entries: entries,
    total_number: entries|length,
    filtered_number: entries|length,
    showmassiveactions: canedit,
    massiveactionparams: {
        num_displayed: entries|length,
        container: 'massPluginNewsAlert_Target' ~ rand,
        specific_actions: {
            delete: _x('button', 'Delete permanently', 'news'),
        },
    },
} only %}

